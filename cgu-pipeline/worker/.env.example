# Use the deployed master domain here when this worker runs on another machine.
MASTER_BASE_URL=http://localhost
# Must match master MASTER_ACCESS_KEY when the master protects worker endpoints.
MASTER_ACCESS_KEY=
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=300.0
WORKER_REQUEST_TIMEOUT_MS=30000
WORKER_ARCHIVE_MAX_VISITS=10
WORKER_FAILURE_BACKOFF_SECONDS=60.0
