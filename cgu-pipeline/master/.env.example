# Master task and deployment overrides. The built-in Taskfile defaults cover
# local dev when this file is absent; these values are production/container-safe.
DEPLOY_ROOT=/srv/cgu-pipeline
# Caddy site address. Use a public domain for shared deployments, or :80 to
# accept requests for any host/IP on an internal machine.
SITE_ADDRESS=:80
DATABASE_URL=postgres://postgres:postgres@postgres:5432/cgu_pipeline
PORT=4000
BUCKET_ENDPOINT_SCHEME=http
BUCKET_ENDPOINT_HOST=minio
BUCKET_ENDPOINT_PORT=9000
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=cgu_pipeline
BUCKET_SECRET_ACCESS_KEY=cgu_pipeline_dev_password
BUCKET_NAME=cgu-pipeline-artifacts
BUCKET_REQUEST_TIMEOUT_MS=30000
# Required when coworkers or remote workers call protected master endpoints.
# Use the same value in worker MASTER_ACCESS_KEY.
MASTER_ACCESS_KEY=
